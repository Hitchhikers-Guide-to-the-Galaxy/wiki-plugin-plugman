{
  "name": "wiki-plugin-plugman",
  "version": "0.2.1",
  "description": "Federated Wiki - PlugMan Plugin, a plugin manager grown from a clone of Plugmatic",
  "keywords": [
    "plugman",
    "plugmatic",
    "wiki",
    "federated wiki",
    "plugin"
  ],
  "author": {
    "name": "David Bovill",
    "url": "https://david.bovill.me"
  },
  "contributors": [
    "Ward Cunningham <ward@c2.com>",
    "Paul Rodwell <paul.rodwell@btinternet.com>",
    "decaffeinate <paul.rodwell@btinternet.com>",
    "Nick Niemeir <nick.niemeir@gmail.com>"
  ],
  "scripts": {
    "build": "npm run clean; eslint; npm run test; node scripts/build-client.js",
    "clean": "rm -f client/plugman.js client/plugman.js.map client/plugmatic.js client/plugmatic.js.map",
    "lint": "eslint",
    "test": "node --test",
    "prettier:format": "prettier --write './**/*.js'",
    "prettier:check": "prettier --check ./**/*.js",
    "update-authors": "node scripts/update-authors.cjs"
  },
  "files": [
    "client",
    "server",
    "pages",
    "factory.json"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.0",
    "eslint": "^10.3.0",
    "expect.js": "^0.3.1",
    "globals": "^17.6.0",
    "grunt-git-authors": "^3.2.0",
    "prettier": "^3.8.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hitchhikers-Guide-to-the-Galaxy/wiki-plugin-plugman.git"
  },
  "bugs": {
    "url": "https://github.com/Hitchhikers-Guide-to-the-Galaxy/wiki-plugin-plugman/issues"
  },
  "homepage": "http://plugin.fedwiki.club/view/plugman-plugin",
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "dependencies": {
    "async": "^3.2.6",
    "glob": "^13.0.6",
    "jsonfile": "^6.2.1"
  }
}
